<!-- Bewusst ohne INTERNET (AE-19, #59); die CI prüft das an der fertigen APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".DaysAndKeysApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/datenauszug"
        android:icon="@mipmap/ic_launcher"
        android:label="Days &amp; Keys"
        android:supportsRtl="false"
        android:theme="@style/Thema">

        <!-- Launcher-Activity muss exportiert sein; sie nimmt nur MAIN/LAUNCHER an und wertet keine Intent-Daten aus (#113). -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".plattform.ErinnerungEmpfaenger" android:exported="false" />
        <receiver android:name=".plattform.StartEmpfaenger" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="de.blackforttec.daysandkeys.PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
